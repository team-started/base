TCEFORM {
  pages {

  }

  tt_content {
    # TYPO3-Core CE's
    CType.keepItems := addToList(text)
    CType.keepItems := addToList(starter_textmedia)

    # EXT:starter CE's
    CType.keepItems := addToList(starter_media)
    CType.keepItems := addToList(starter_accordion)
    CType.keepItems := addToList(starter_distribution_navigation)
    CType.keepItems := addToList(starter_download)

    # disable TYPO3-Core fields
    image_zoom.disabled = 1

    imagecols {
      types {
        starter_textmedia.disabled = 1
      }
    }

    tx_starter_width {
      addItems {
        container-sm = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-sm
        container-md = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-md
        container-lg = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-lg
        container-xl = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-xl
        container-xxl = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-xxl
        container-fluid = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-fluid
        container-sm-fixed = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-sm-fixed
        container-md-fixed = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-md-fixed
        container-lg-fixed = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-lg-fixed
        container-xl-fixed = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-xl-fixed
        container-xxl-fixed = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:tx_starter_width.container-xxl-fixed
      }
    }

    space_before_class {
      addItems {
        mt-1 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.1
        mt-2 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.2
        mt-3 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.3
        mt-4 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.4
        mt-5 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.5
      }
    }

    space_after_class {
      addItems {
        mb-1 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.1
        mb-2 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.2
        mb-3 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.3
        mb-4 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.4
        mb-5 = LLL:EXT:starter_freya/Resources/Private/Language/locallang_be.xlf:space_class.5
      }
    }

    imageorient {
      removeItems = 0,1,2,8,9,10
    }

    assets {
      config {
        minitems = 1
        maxitems = 1
      }
    }
  }
}
